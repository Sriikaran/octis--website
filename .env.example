# =========================================================================
# OCTIS STANDALONE MARKETING WEBSITE — ENVIRONMENT CONFIGURATION
# =========================================================================
# Copy this file to .env.local for local development.
# Configure these variables in your hosting environment (e.g., Vercel, Netlify, Docker).
#
# IMPORTANT SECURITY & ISOLATION NOTE:
# This project is completely isolated from the Octis Jewellery ERP application.
# NEVER insert ERP production credentials (ERP database, ERP JWT secret, Supabase
# service keys for the ERP, etc.) into this environment.
# =========================================================================

# -------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Exposed to the browser)
# -------------------------------------------------------------------------
# Canonical URL of the public marketing website
NEXT_PUBLIC_SITE_URL=https://octis.in

# External ERP login URL for showroom customers & staff
NEXT_PUBLIC_ERP_LOGIN_URL=https://app.octis.in/login

# -------------------------------------------------------------------------
# 2. SERVER-SIDE ADMINISTRATIVE SECURITY (Confidential)
# -------------------------------------------------------------------------
# Secret key required to access the Demo Appointments & Enquiry Admin Portal
# (/admin/demo-bookings and /api/demo/bookings/*).
#
# MANDATORY IN PRODUCTION: You MUST set a strong, random 32+ character secret in production.
# In production mode, the server will reject admin requests if this variable is missing.
DEMO_ADMIN_KEY=your-secure-random-admin-secret-at-least-32-chars

# Business operational timezone for appointment calculation (default: Asia/Kolkata)
DEMO_TIMEZONE=Asia/Kolkata

# -------------------------------------------------------------------------
# 3. SERVER-SIDE ISOLATED PERSISTENCE (Optional / Recommended for Serverless)
# -------------------------------------------------------------------------
# Dedicated marketing PostgreSQL database connection string (e.g., Supabase, Neon, AWS RDS).
# If omitted, the website uses local atomic JSON file persistence (data/demo_bookings.json),
# which is suitable for local development and traditional persistent Docker/VPS hosting.
# For serverless hosting (e.g., Vercel), provide a dedicated database connection.
#
# DEMO_DATABASE_URL=postgresql://octis_web_user:password@db.provider.com:5432/octis_website_db

# -------------------------------------------------------------------------
# 4. SERVER-SIDE EMAIL NOTIFICATION TRANSPORT (Optional)
# -------------------------------------------------------------------------
# If omitted, appointment bookings and contact inquiries will still succeed,
# and dispatch notices will be logged to server diagnostics without crashing.
#
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@octis.in
# SMTP_PASS=your-smtp-password
# SMTP_FROM=hello@octis.in
#
# Alternatively, SendGrid API Key:
# SENDGRID_API_KEY=SG.your_api_key_here

# -------------------------------------------------------------------------
# 5. PRECIOUS METAL SPOT QUOTES
# -------------------------------------------------------------------------
# The homepage reads international gold and silver spot quotes from Gold API:
#   https://api.gold-api.com/price/XAU/INR
#   https://api.gold-api.com/price/XAG/INR
# The real-time price endpoint does not require an account or an API key.
# Prices are INR per troy ounce and are converted to INR per gram on the server.
# They are spot quotes, not showroom board rates, and they do not include GST.
# Do not add a key, and do not call this provider from the browser.
